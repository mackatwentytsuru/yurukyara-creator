# 鍵は環境変数から読みます。値はここに書かず、自分の環境に設定してください。
# ANTHROPIC_API_KEY=   (Haiku を呼びます)
# ELEVENLABS_API_KEY=  (読み上げ。聞き取りに使うなら speech_to_text の許可も要ります)

# 読み上げの文字数の上限(1 日あたり)。月の枠を使い切らないための安全装置
ELEVEN_DAILY_CHAR_CAP=3000
# 声の役(男の子・女の子)の既定を替える時だけ(空 = src/conversation/voiceRole.js の既定)
ELEVEN_VOICE_MALE=
ELEVEN_VOICE_FEMALE=
# 頭脳と声のモデル。空 = src/conversation/models.js の既定(名前はそこ 1 か所。新しいモデルはこの 2 行か、そのファイルの 1 行で替わる)
CLAUDE_MODEL=
ELEVEN_MODEL_ID=

# 聞き取り(Quest 3 など、ブラウザに聞き取りが無い端末用)。pip install faster-whisper で使えるようになる。off で使わない
# STT_ENGINE=
# STT_MODEL=small   (base は字が外れた: 同じ録音の「19時」が崩れた。2026-11-04)
# STT_DEVICE=cpu
# STT_THREADS=4
# STT_PYTHON=python

# 開発中の試しにだけ使う VRM のローカルのパス(リポジトリには入れません)
# DEV_VRM_PATH=
PORT=8787
# 待ち受ける先。既定は自分の端末だけ(127.0.0.1)。同じネットワークの別の端末から開くときだけ 0.0.0.0
# HOST=127.0.0.1
# Claude の呼び出しの上限(1 日の回数、1 接続元あたり 1 分の回数)。誰でも開ける URL を出すときは必ず付ける
CLAUDE_DAILY_CALL_CAP=300
CLAUDE_PER_MINUTE=12
# 最初の文字が遅いとき、2 本目の呼び出しを送って早い方を使う(ms。0 で無効、既定は無効)
# CLAUDE_HEDGE_MS=0
