# 鍵は環境変数から読みます。値はここに書かず、自分の環境に設定してください。
# ANTHROPIC_API_KEY=   (Haiku を呼びます)
# ELEVENLABS_API_KEY=  (読み上げ。聞き取りに使うなら speech_to_text の許可も要ります)

# 読み上げの文字数の上限(1 日あたり)。月の枠を使い切らないための安全装置
ELEVEN_DAILY_CHAR_CAP=3000
ELEVEN_VOICE_ID=fUjY9K2nAIwlALOwSiwc
ELEVEN_MODEL_ID=eleven_flash_v2_5
CLAUDE_MODEL=claude-haiku-5-5

# 開発中の試しにだけ使う VRM のローカルのパス(リポジトリには入れません)
# DEV_VRM_PATH=
PORT=8787
# 待ち受ける先。既定は自分の端末だけ(127.0.0.1)。同じネットワークの別の端末から開くときだけ 0.0.0.0
# HOST=127.0.0.1
# Claude の呼び出しの上限(1 日の回数、1 接続元あたり 1 分の回数)。誰でも開ける URL を出すときは必ず付ける
CLAUDE_DAILY_CALL_CAP=300
CLAUDE_PER_MINUTE=12
# 最初の文字が遅いとき、2 本目の呼び出しを送って早い方を使う(ms。0 で無効、既定は無効)
# CLAUDE_HEDGE_MS=0
