# 使う人がブラウザで作った子(characters/yb<日付>_<乱数>/)は、その人の手元の物。リポジトリに入れない
characters/yb*/

# 外から持ってきたキャラ(VRM)はリポジトリに入れない
characters/*/model.vrm
*.vrm

# 公開の関数の手元の設定(鍵や合言葉を置く場所。コミットしない)
.vercel/
.env.*
!.env.example
web/dist/

# 手元だけで試す素材(使用条件で再配布できない物)。公開のリポジトリに入れない
creator/viewer/assets_local/

# 作る段の作業フォルダ(段の記録・確認の状態・フックの記録。コミットしない)
creator/work/

# アップデートの控えと、最後に確かめた時(tools/yuru_update.py。使う人の手元だけの物)
backups/
